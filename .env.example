# Copy this file to .env.local and fill it in.

# Nebius Token Factory: create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_API_BASE=https://api.tokenfactory.nebius.com/v1/

# Nemotron model IDs. Run `npm run models` to see the exact IDs your key can use.
# Nano extracts claims and writes the report, Super checks simple claims, Ultra handles complex or uncertain ones.
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=

# Tavily web search: create a key at https://app.tavily.com
TAVILY_API_KEY=
